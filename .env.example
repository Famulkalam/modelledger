# Copy to .env and fill in. Never commit .env.

# API key clients send in the X-API-Key header
MODELLEDGER_API_KEY=change-me

# Ed25519 anchor-signing keys: generate with `python scripts/generate_keys.py`
# Keep the signing key secret (production: KMS/HSM). The public key can be shared
# with auditors so they can verify anchors without being able to create them.
ANCHOR_SIGNING_KEY=
ANCHOR_PUBLIC_KEY=

# Where signed anchor files are written (production: write-once storage
# controlled by a different team)
ANCHOR_DIR=anchors
ANCHOR_INTERVAL=100

DB_PATH=data/modelledger.db
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT=1000/minute
UVICORN_WORKERS=1
