    "/decisions/{decision_id}/outcome": {
      "patch": {
        "summary": "Record Outcome",
        "description": "Record the repayment outcome as a new chained event (never an overwrite).\n\nSending a corrected outcome adds another event; the latest event is used\nfor monitoring and the earlier one stays in the audit trail.",
