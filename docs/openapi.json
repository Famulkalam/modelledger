  "components": {
    "schemas": {
      "DecisionRequest": {
        "properties": {
          "input_features": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input Features"
          },
          "prediction": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Prediction",
            "description": "1 = approve, 0 = decline"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "Model probability of approval"
          },
          "shap_values": {
            "additionalProperties": true,
            "type": "object",
            "title": "Shap Values"
          },
          "age_group": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Group"
          },
          "sex": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sex"
          }
        },
        "type": "object",
        "required": [
          "input_features",
          "prediction",
          "score",
          "shap_values"
        ],
        "title": "DecisionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OutcomeRequest": {
        "properties": {
          "true_label": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "True Label",
            "description": "1 = repaid, 0 = defaulted"
          }
        },
        "type": "object",
        "required": [
          "true_label"
        ],
        "title": "OutcomeRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}